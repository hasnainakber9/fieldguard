# Copy to .env (never commit .env) and set only the values your project needs.
# FieldGuard reads these from the process environment; it never prints secrets.

# --- Outputs -----------------------------------------------------------------
# Default folder for `fieldguard demo` / `benchmark` outputs (CLI --out overrides it).
FIELDGUARD_REPORTS_DIR=D:\ComputationalLab\reports\fieldguard

# Salt for hashing respondent IDs / PII in shared reports (any long random string).
FIELDGUARD_HASH_SALT=

# --- Optional PostgreSQL sink (schema "fieldguard") ---------------------------
# SQLAlchemy URL, psycopg 3 driver. Put the real password only in your local .env.
# FIELDGUARD_DATABASE_URL=postgresql+psycopg://lab:<password>@127.0.0.1:5432/lab
FIELDGUARD_DATABASE_URL=

# --- KoboToolbox API v2 --------------------------------------------------------
# Server: https://kf.kobotoolbox.org (global) or https://eu.kobotoolbox.org (EU) or your own.
KOBO_SERVER_URL=https://kf.kobotoolbox.org
KOBO_TOKEN=
KOBO_ASSET_UID=

# --- ODK Central (OData) ------------------------------------------------------
ODK_CENTRAL_URL=
ODK_CENTRAL_PROJECT_ID=
ODK_CENTRAL_FORM_ID=
# Either a bearer/session token ...
ODK_CENTRAL_TOKEN=
# ... or HTTP Basic credentials of a (preferably read-only) web user.
ODK_CENTRAL_EMAIL=
ODK_CENTRAL_PASSWORD=

# --- SurveyCTO server API -----------------------------------------------------
# Server name only, e.g. "myorg" for https://myorg.surveycto.com
SURVEYCTO_SERVER=
SURVEYCTO_FORM_ID=
SURVEYCTO_USERNAME=
SURVEYCTO_PASSWORD=
