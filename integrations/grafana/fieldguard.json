{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "FieldGuard PostgreSQL",
      "description": "Postgres datasource holding the fieldguard schema (created by the FieldGuard PostgreSQL sink)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "FieldGuard survey quality dashboard. Flags are leads for supervisory review, not proof of misconduct.",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "uid": "fieldguard-quality",
  "title": "FieldGuard survey quality",
  "tags": [
    "fieldguard",
    "survey-quality",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1h",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_POSTGRES",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_POSTGRES}"
        },
        "definition": "SELECT DISTINCT project FROM fieldguard.runs ORDER BY 1",
        "query": {
          "refId": "P",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT project FROM fieldguard.runs ORDER BY 1",
          "format": "table",
          "editorMode": "code"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "sort": 1
      },
      {
        "name": "include_synthetic",
        "label": "Include synthetic runs",
        "type": "custom",
        "query": "no,yes",
        "current": {
          "text": "no",
          "value": "no"
        },
        "options": [
          {
            "text": "no",
            "value": "no",
            "selected": true
          },
          {
            "text": "yes",
            "value": "yes",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Flags are **leads for supervisory review, not proof of misconduct**. They must not trigger automated sanctions. Synthetic runs are hidden unless `include_synthetic` is set to yes. Data come from the `fieldguard` schema written by `fieldguard run` (PostgreSQL sink)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Flagged enumerators (latest run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS flagged FROM fieldguard.scorecards s WHERE s.run_id = (SELECT run_id FROM fieldguard.runs r WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') ORDER BY r.started_at DESC LIMIT 1) AND s.flagged"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Critical issues (latest run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS critical FROM fieldguard.issues i WHERE i.run_id = (SELECT run_id FROM fieldguard.runs r WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') ORDER BY r.started_at DESC LIMIT 1) AND i.severity = 'critical'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Records (latest run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT n_records AS records FROM fieldguard.runs WHERE run_id = (SELECT run_id FROM fieldguard.runs r WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') ORDER BY r.started_at DESC LIMIT 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Enumerators (latest run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT n_enumerators AS enumerators FROM fieldguard.runs WHERE run_id = (SELECT run_id FROM fieldguard.runs r WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') ORDER BY r.started_at DESC LIMIT 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Issues by severity over runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.started_at AS time, i.severity AS metric, COUNT(*) AS value FROM fieldguard.issues i JOIN fieldguard.runs r ON r.run_id = i.run_id WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') AND $__timeFilter(r.started_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Flagged enumerators over runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.started_at AS time, COUNT(*) FILTER (WHERE s.flagged) AS flagged, COUNT(*) AS enumerators FROM fieldguard.scorecards s JOIN fieldguard.runs r ON r.run_id = s.run_id WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') AND $__timeFilter(r.started_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Enumerator risk (latest run; redacted pseudonyms if configured)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.enumerator, s.n_interviews, s.risk_score, s.rule_score, s.anomaly_score, s.flagged, s.top_reasons FROM fieldguard.scorecards s WHERE s.run_id = (SELECT run_id FROM fieldguard.runs r WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') ORDER BY r.started_at DESC LIMIT 1) ORDER BY s.risk_score DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "risk_score",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Issues by check (latest run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT i.check_id, i.severity, COUNT(*) AS issues FROM fieldguard.issues i WHERE i.run_id = (SELECT run_id FROM fieldguard.runs r WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') ORDER BY r.started_at DESC LIMIT 1) GROUP BY 1, 2 ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.run_id, r.started_at, r.mode, r.synthetic, r.n_records, r.n_new_records, r.n_issues, r.fieldguard_version FROM fieldguard.runs r WHERE r.project = '$project' AND (r.synthetic = false OR '$include_synthetic' = 'yes') ORDER BY r.started_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}